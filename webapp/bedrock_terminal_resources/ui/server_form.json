{
  "namespace": "server_form",
  "main_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "cinter_form_factory": {
              "type": "panel",
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "custom_form": "@server_form.cinter_command"
                }
              },
              "size": [
                "100%",
                "100%"
              ]
            }
          }
        ]
      }
    ],
    "size": [
      "100%",
      "100%"
    ]
  },
  "custom_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_name": "#title_text"
          },
          {
            "binding_type": "view",
            "source_property_name": "(not (#title_text = 'CinterForge Terminal \u2014 Command'))",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },
  "cinter_command": {
    "type": "panel",
    "size": [
      "100% - 16px",
      38
    ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [
      0,
      -8
    ],
    "layer": 3,
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#title_text = 'CinterForge Terminal \u2014 Command')",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "bar": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [
            "100%",
            32
          ],
          "controls": [
            {
              "input@server_form.cinter_generated_contents": {
                "size": [
                  "fill",
                  32
                ]
              }
            },
            {
              "submit@common_buttons.light_text_button": {
                "size": [
                  56,
                  24
                ],
                "$pressed_button_name": "button.submit_custom_form",
                "$button_text": "Enter",
                "bindings": [
                  {
                    "binding_name": "#submit_button_visible",
                    "binding_name_override": "#visible"
                  },
                  {
                    "binding_name": "#title_text"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#title_text = 'CinterForge Terminal \u2014 Command')",
                    "target_property_name": "#enabled"
                  }
                ],
                "button_mappings": [
                  {
                    "from_button_id": "button.menu_select",
                    "to_button_id": "button.submit_custom_form",
                    "mapping_type": "pressed"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "cinter_generated_contents@server_form.generated_contents": {
    "factory": {
      "name": "buttons",
      "control_ids": {
        "input": "@server_form.cinter_input"
      }
    }
  },
  "cinter_input@common.text_edit_box": {
    "size": [
      "100%",
      24
    ],
    "max_length": 180,
    "always_listening": true,
    "default_focus_precedence": 1,
    "$focus_id": "cinter_command_input",
    "$text_box_name": "custom_input",
    "$text_edit_box_grid_collection_name": "custom_form",
    "$text_edit_box_content_binding_type": "collection",
    "$text_edit_box_content_binding_name": "#custom_input_text",
    "$text_edit_box_placeholder_content_binding_type": "collection",
    "$text_edit_box_placeholder_content_binding_name": "#custom_placeholder_text",
    "$text_edit_box_enabled_binding_type": "collection",
    "$text_box_enabled_binding_name": "#custom_input_enabled",
    "bindings": [
      {
        "binding_type": "collection",
        "binding_collection_name": "custom_form",
        "binding_name": "#custom_input_enabled",
        "binding_name_override": "#enabled"
      },
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#title_text = 'CinterForge Terminal \u2014 Command')",
        "target_property_name": "#visible"
      }
    ],
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$text_edit_box_selected_to_button_id",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$text_edit_box_selected_to_button_id",
        "handle_select": false,
        "handle_deselect": true,
        "mapping_type": "global",
        "consume_event": false
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.submit_custom_form",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "$text_edit_box_deselected_to_button_id",
        "handle_select": false,
        "handle_deselect": true,
        "mapping_type": "global",
        "consume_event": false
      }
    ]
  }
}
