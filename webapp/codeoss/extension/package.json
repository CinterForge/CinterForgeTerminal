{
  "name": "cinterforge-if",
  "displayName": "CinterForge Interactive Fiction",
  "description": "CinterForge workspace, Inform compile, diagnostics, and live IF terminal bridge.",
  "version": "0.1.0",
  "publisher": "cinterforge",
  "engines": {
    "vscode": "^1.137.0"
  },
  "browser": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "enabledApiProposals": [
    "fileSearchProvider",
    "textSearchProvider"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:cinterforge",
    "onCommand:cinterforge.compileInform",
    "onCommand:cinterforge.openIFTerminal",
    "onCommand:cinterforge.toggleColorTheme",
    "onLanguage:zil",
    "onLanguage:inform6",
    "onCommand:cinterforge.buildStory",
    "onCommand:cinterforge.newTerminal",
    "onCommand:cinterforge.newStory",
    "onCommand:cinterforge.importStory",
    "onCommand:cinterforge.loadStory",
    "onCommand:cinterforge.openFolder",
    "onCommand:cinterforge.openWorkspace",
    "onCommand:cinterforge.newMacTerminal",
    "onCommand:cinterforge.newLinuxTerminal",
    "onCommand:cinterforge.newWindowsTerminal",
    "onCommand:cinterforge.newServerLogTerminal",
    "onCommand:cinterforge.openMacLauncher",
    "onCommand:cinterforge.openWindowsLauncher",
    "onCommand:cinterforge.openLinuxLauncher"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cinterforge.compileInform",
        "title": "CinterForge: Compile Inform"
      },
      {
        "command": "cinterforge.openIFTerminal",
        "title": "CinterForge: Open IF Terminal"
      },
      {
        "command": "cinterforge.toggleColorTheme",
        "title": "CinterForge: Toggle Light/Dark Mode"
      },
      {
        "command": "cinterforge.buildStory",
        "title": "CinterForge: Build Story Package"
      },
      {
        "command": "cinterforge.newTerminal",
        "title": "CinterForge: New Terminal"
      },
      {
        "command": "cinterforge.newMacTerminal",
        "title": "CinterForge: New Mac Terminal"
      },
      {
        "command": "cinterforge.newLinuxTerminal",
        "title": "CinterForge: New Linux Terminal"
      },
      {
        "command": "cinterforge.newWindowsTerminal",
        "title": "CinterForge: New Windows Terminal"
      },
      {
        "command": "cinterforge.newServerLogTerminal",
        "title": "CinterForge: New Server Log Terminal"
      },
      {
        "command": "cinterforge.newStory",
        "title": "New Story…"
      },
      {
        "command": "cinterforge.importStory",
        "title": "Import Story…"
      },
      {
        "command": "cinterforge.loadStory",
        "title": "Open Story…"
      },
      {
        "command": "cinterforge.openFolder",
        "title": "CinterForge: Open Local Folder…"
      },
      {
        "command": "cinterforge.openWorkspace",
        "title": "CinterForge: Open Local Workspace…"
      },
      {
        "command": "cinterforge.openHostLog",
        "title": "CinterForge: Open Host Log or File…"
      },
      {
        "command": "cinterforge.revealInHostOS",
        "title": "CinterForge: Reveal in Host File Manager"
      },
      {
        "command": "cinterforge.openMacLauncher",
        "title": "Mac Launcher"
      },
      {
        "command": "cinterforge.openWindowsLauncher",
        "title": "Windows Launcher"
      },
      {
        "command": "cinterforge.openLinuxLauncher",
        "title": "Linux Launcher"
      }
    ],
    "configuration": {
      "title": "CinterForge",
      "properties": {
        "cinterforge.controlBase": {
          "type": "string",
          "default": "",
          "description": "Optional CinterForge IF control service base URL. Same-origin is used when empty."
        }
      }
    },
    "languages": [
      {
        "id": "inform7",
        "aliases": [
          "Inform 7",
          "Inform"
        ],
        "extensions": [
          ".ni",
          ".inform"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "inform6",
        "aliases": [
          "Inform 6",
          "Inform"
        ],
        "extensions": [
          ".inf"
        ],
        "configuration": "./inform6-language-configuration.json"
      },
      {
        "id": "zil",
        "aliases": [
          "ZIL",
          "Zork Implementation Language"
        ],
        "extensions": [
          ".zil"
        ],
        "configuration": "./zil-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "inform7",
        "scopeName": "source.inform7",
        "path": "./syntaxes/inform7.tmLanguage.json"
      },
      {
        "language": "inform6",
        "scopeName": "source.inform6",
        "path": "./syntaxes/inform6.tmLanguage.json"
      },
      {
        "language": "zil",
        "scopeName": "source.zil",
        "path": "./syntaxes/zil.tmLanguage.json"
      }
    ],
    "terminal": {
      "profiles": [
        {
          "id": "cinterforge.native",
          "title": "CinterForge Terminal"
        }
      ]
    },
    "configurationDefaults": {
      "workbench.colorTheme": "Default Dark Modern"
    },
    "menus": {
      "explorer/context": [
        {
          "command": "cinterforge.revealInHostOS",
          "when": "resourceScheme == cinterforge || resourceScheme == cinterforge-host",
          "group": "navigation@30"
        }
      ],
      "editor/title/context": [
        {
          "command": "cinterforge.revealInHostOS",
          "when": "resourceScheme == cinterforge || resourceScheme == cinterforge-host",
          "group": "navigation@30"
        }
      ],
      "editor/context": [
        {
          "command": "cinterforge.revealInHostOS",
          "when": "resourceScheme == cinterforge || resourceScheme == cinterforge-host",
          "group": "navigation@30"
        }
      ],
      "openEditors/context": [
        {
          "command": "cinterforge.revealInHostOS",
          "when": "resourceScheme == cinterforge || resourceScheme == cinterforge-host",
          "group": "navigation@30"
        }
      ]
    }
  }
}
